generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  hashedPassword String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  uploadedPhotos  UploadedPhoto[]
  trainingJobs    TrainingJob[]
  generatedImages GeneratedImage[]
}

model UploadedPhoto {
  id            String   @id @default(cuid())
  userId        String
  cloudinaryUrl String
  cloudinaryId  String
  originalName  String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingJob {
  id                  String    @id @default(cuid())
  userId              String
  replicateTrainingId String?   @unique
  status              String    @default("pending")
  triggerWord         String    @default("TOK")
  loraWeightsUrl      String?
  photoCount          Int       @default(0)
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedImages GeneratedImage[]
}

model GeneratedImage {
  id                    String   @id @default(cuid())
  userId                String
  trainingJobId         String
  replicatePredictionId String?  @unique
  prompt                String
  cloudinaryUrl         String?
  cloudinaryId          String?
  status                String   @default("pending")
  errorMessage          String?
  createdAt             DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingJob TrainingJob @relation(fields: [trainingJobId], references: [id], onDelete: Cascade)
}
